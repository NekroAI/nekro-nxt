<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nxt_canvas"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/noticeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/nxt_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/noticeMessage"
        style="@style/Nxt.Note"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/noticeRetry"
        style="@style/Nxt.PrimaryButton"
        android:text="重试" />

    <Button
        android:id="@+id/noticeConnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:text="切换或重新连接实例"
        android:textColor="@color/nxt_accent"
        android:textSize="15sp" />
</LinearLayout>
