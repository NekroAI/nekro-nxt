{
  "name": "@nekro-nxt/extension-format",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "NekroNXT 扩展包格式：.nxt-extension 结构校验、扩展清单与内容摘要",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./dist/index.mjs",
      "source": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "lib/types",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run --root ../.. packages/extension-format/tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nekro-nxt/contracts": "workspace:^",
    "@noble/hashes": "2.3.0",
    "fflate": "0.8.3",
    "postcss": "8.5.26",
    "zod": "4.4.3"
  },
  "author": "NekroAI contributors",
  "homepage": "https://github.com/NekroAI/nekro-nxt/tree/main/packages/extension-format#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NekroAI/nekro-nxt.git",
    "directory": "packages/extension-format"
  },
  "bugs": {
    "url": "https://github.com/NekroAI/nekro-nxt/issues"
  }
}
