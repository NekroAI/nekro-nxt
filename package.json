{
  "name": "nekro-nxt",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "NekroNXT：基于 DeepSeek Harness（DSH）的多平台群聊智能体系统｜A DSH-powered multi-platform group-chat agent system",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:glin": "NEKRO_DATA=../../.local/glin-experiment-data NEKRO_PORT=5960 NEKRO_API_PROXY=http://127.0.0.1:5960 NEKRO_WEB_PORT=5961 pnpm -r --parallel --if-present run dev",
    "dsh:check-update": "node scripts/check-dsh-update.mjs",
    "desktop:preview": "node scripts/release-desktop.mjs preview",
    "desktop:stable": "node scripts/release-desktop.mjs stable",
    "release": "node scripts/stable-release.mjs",
    "dist:server": "node scripts/build-server-image.mjs",
    "brand:export": "node scripts/export-brand-assets.mjs",
    "brand:check": "node scripts/check-brand-assets.mjs",
    "build": "tsc -b && pnpm -r --if-present run build && node scripts/check-built-exports.mjs",
    "check": "pnpm check:format && pnpm typecheck && pnpm lint && pnpm check:static && pnpm check:drizzle && pnpm check:css-types && pnpm check:docs && pnpm check:public && pnpm brand:check && pnpm check:workspace && pnpm check:dsh-family && pnpm check:ui-boundary && pnpm check:ui-actions && pnpm check:gates",
    "check:css-types": "node scripts/check-css-module-types.mjs",
    "check:format": "prettier --check .",
    "check:docs": "node scripts/check-doc-links.mjs && node scripts/check-decision-status.mjs && node scripts/check-terminology.mjs && node scripts/check-brand-name.mjs",
    "check:drizzle": "node scripts/check-drizzle-migrations.mjs",
    "check:dsh-family": "node scripts/check-dsh-family.mjs",
    "check:gates": "node --test scripts/tests/*.spec.mjs",
    "prototype": "python3 -m http.server 4173 --directory prototype",
    "check:prototype": "node --check prototype/app.js",
    "check:public": "node scripts/check-public-boundary.mjs",
    "check:static": "node scripts/check-static-safety.mjs",
    "check:workspace": "node scripts/check-workspace-boundaries.mjs && node scripts/check-react-singleton.mjs",
    "check:ui-boundary": "node scripts/check-ui-boundary.mjs",
    "check:ui-actions": "node scripts/check-actionable-ui.mjs",
    "format": "prettier --write .",
    "generate:css-types": "node scripts/check-css-module-types.mjs --write",
    "lint": "node scripts/check-eslint.mjs",
    "test": "vitest run",
    "test:journey": "pnpm --filter @nekro-nxt/web build && pnpm --filter @nekro-nxt/server build && playwright test",
    "test:coverage": "vitest run --coverage --exclude apps/web/tests/app.spec.tsx --exclude apps/web/tests/ui-kit-browser.spec.tsx --exclude apps/desktop/tests/instance-overlay.spec.ts",
    "smoke:better-sqlite3": "node scripts/smoke-better-sqlite3.mjs",
    "verify:product": "pnpm check && pnpm test && pnpm build && playwright test",
    "typecheck": "tsc -b && tsc -p tsconfig.lint.json && tsc -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "9.39.5",
    "imagetracerjs": "^1.2.6",
    "prettier": "3.9.6",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "unrun": "0.3.1",
    "vitest": "4.1.8"
  },
  "author": "NekroAI contributors",
  "homepage": "https://github.com/NekroAI/nekro-nxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NekroAI/nekro-nxt.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/NekroAI/nekro-nxt/issues"
  }
}
