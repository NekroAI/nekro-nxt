{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "sourceMap": false
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "docs/site/flows/**/*.ts",
    "docs/site/widgets/**/*.ts",
    "docs/site/widgets/**/*.tsx",
    "playwright.config.ts",
    "playwright.docs.config.ts",
    "playwright.browser.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["apps/desktop/dist/**", "apps/desktop/release/**"]
}
